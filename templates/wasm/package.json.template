{
  "name": "{pkg_name}",
  "version": "{npm_version}",
  "type": "module",
  "types": "./index.d.ts",
  "description": "Tree-sitter parser and queries for {languages_text}, compiled to WASM for Lumis",
  "author": "Leandro Pereira",
  "license": "MIT",
  "homepage": "https://lumis.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./{wasm_name}.wasm": "./{wasm_name}.wasm",
    "./lumis.json": "./lumis.json"
  },
  "lumis": {
    "treeSitter": "{tree_sitter_cli}",
    "formatVersion": 3,
    "definitionHash": "{definition_hash}"
  },
  "keywords": ["lumis-sh", "wasm", "tree-sitter"],
  "files": ["*.wasm", "*.json", "*.js", "*.d.ts", "README.md", "LICENSE"]
}
