  # reason the lock file never suited one.
  def project do
    [
      app: :{app_name},
      version: "{hex_version}",
      elixir: "~> 1.15",
      description: "Lumis parser bundle: {languages_text}",
      deps: deps(),
      package: package()
    ]
  end

  def application, do: []

  defp deps do
    [
{deps}
    ]
  end

  defp package do
    [
      maintainers: ["Leandro Pereira"],
      licenses: ["MIT"],
      links: %{
        "Lumis" => "https://lumis.sh",
        "GitHub" => "https://github.com/leandrocp/lumis"
      },
      files: ~w[mix.exs README.md LICENSE]
    ]
  end
end
