          "start": 0,
          "end": 4
        }
      ],
      "annotations": [
        {
          "range": {
            "type": "offset",
            "start": 2,
            "end": 2
          },
          "data": "first"
        },
        {
          "range": {
            "type": "offset",
            "start": 2,
            "end": 2
          },
          "data": "second"
        }
      ],
      "expected": "T:0-2 A+first@2-2 A- A+second@2-2 A- T:2-4"
    }
  ]
}
