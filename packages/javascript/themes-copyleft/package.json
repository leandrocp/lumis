{
  "name": "@lumis-sh/themes-copyleft",
  "version": "0.1.0",
  "description": "Opt-in copyleft Neovim themes for Lumis Syntax Highlighter",
  "homepage": "https://lumis.sh",
  "license": "SEE LICENSE IN dist/NOTICE.md",
  "author": "Leandro Pereira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git",
    "directory": "packages/javascript/themes-copyleft"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lumis-themes.json": "./dist/lumis-themes.json",
    "./json/*.json": "./dist/json/*.json",
    "./json/*": "./dist/json/*.json",
    "./css/*.css": "./dist/css/*.css",
    "./css/*": "./dist/css/*.css",
    "./*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js",
      "require": "./dist/themes/*.cjs"
    }
  },
  "scripts": {
    "build:themes": "tsx ../themes/scripts/build-themes.ts --pack=copyleft --step=ts",
    "build:assets": "tsx ../themes/scripts/build-themes.ts --pack=copyleft --step=json",
    "build": "pnpm run build:themes && tsup && pnpm run build:assets",
    "lint": "oxlint -c ../../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives .",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lumis-sh/themes": "workspace:^"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsup": "^9.0",
    "tsx": "^4.23",
    "typescript": "^6.0"
  },
  "packageManager": "pnpm@11.15.1"
}
