{
  "name": "@lumis-sh/lumis",
  "version": "0.10.1",
  "description": "Syntax Highlighter powered by Tree-sitter and Neovim themes",
  "author": "Leandro Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git",
    "directory": "packages/javascript/lumis"
  },
  "bugs": "https://github.com/leandrocp/lumis/issues",
  "homepage": "https://lumis.sh",
  "keywords": [
    "syntax-highlighting",
    "code-highlighting",
    "highlighter",
    "javascript",
    "typescript",
    "tree-sitter",
    "neovim",
    "wasm"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "node": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.browser.js"
    },
    "./client": {
      "import": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "default": "./dist/index.browser.js"
    },
    "./node": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./formatters": {
      "import": {
        "types": "./dist/formatters.d.ts",
        "default": "./dist/formatters.js"
      },
      "require": {
        "types": "./dist/formatters.d.cts",
        "default": "./dist/formatters.cjs"
      }
    },
    "./formatters/html": {
      "import": {
        "types": "./dist/formatters/html.d.ts",
        "default": "./dist/formatters/html.js"
      },
      "require": {
        "types": "./dist/formatters/html.d.cts",
        "default": "./dist/formatters/html.cjs"
      }
    },
    "./formatters/ansi": {
      "import": {
        "types": "./dist/formatters/ansi.d.ts",
        "default": "./dist/formatters/ansi.js"
      },
      "require": {
        "types": "./dist/formatters/ansi.d.cts",
        "default": "./dist/formatters/ansi.cjs"
      }
    },
    "./langs/*": {
      "import": {
        "types": "./dist/langs/*.d.ts",
        "default": "./dist/langs/*.js"
      },
      "require": {
        "types": "./dist/langs/*.d.cts",
        "default": "./dist/langs/*.cjs"
      }
    },
    "./bundles/*": {
      "import": {
        "types": "./dist/bundles/*.d.ts",
        "default": "./dist/bundles/*.js"
      },
      "require": {
        "types": "./dist/bundles/*.d.cts",
        "default": "./dist/bundles/*.cjs"
      }
    },
    "./themes": {
      "browser": {
        "types": "./dist/themes.browser.d.ts",
        "default": "./dist/themes.browser.js"
      },
      "import": {
        "types": "./dist/themes.d.ts",
        "default": "./dist/themes.js"
      },
      "require": {
        "types": "./dist/themes.d.cts",
        "default": "./dist/themes.cjs"
      }
    },
    "./languages": {
      "browser": {
        "types": "./dist/languages.browser.d.ts",
        "default": "./dist/languages.browser.js"
      },
      "require": {
        "types": "./dist/languages.d.cts",
        "default": "./dist/languages.cjs"
      },
      "node": "./dist/languages.js",
      "import": {
        "types": "./dist/languages.d.ts",
        "default": "./dist/languages.js"
      },
      "default": "./dist/languages.browser.js"
    },
    "./client/languages": {
      "import": {
        "types": "./dist/languages.browser.d.ts",
        "default": "./dist/languages.browser.js"
      },
      "default": "./dist/languages.browser.js"
    },
    "./node/languages": {
      "import": {
        "types": "./dist/languages.d.ts",
        "default": "./dist/languages.js"
      },
      "require": {
        "types": "./dist/languages.d.cts",
        "default": "./dist/languages.cjs"
      },
      "default": "./dist/languages.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build:langs": "tsx scripts/build-langs.ts",
    "build:runtime-wasm": "tsx scripts/build-runtime-wasm.ts",
    "build:generate": "pnpm run build:runtime-wasm && pnpm run build:langs",
    "build:native": "cargo build -p lumis-js-native --release && tsx scripts/copy-native.ts",
    "build": "pnpm --filter @lumis-sh/themes run build && pnpm run build:generate && tsup && tsup --config tsup.browser.config.ts && node scripts/patch-web-tree-sitter-bundle.mjs && node scripts/check-declarations.mjs && node scripts/check-package-types.mjs",
    "test": "vitest run --exclude test/conformance.test.ts --exclude test/query-compile.test.ts --exclude 'test/browser/**'",
    "test:queries": "vitest run test/query-compile.test.ts",
    "test:conformance": "vitest run test/conformance.test.ts",
    "test:conformance:browser": "playwright test",
    "test:all-languages": "vitest run test/all-languages.test.ts",
    "dev": "vite",
    "docs": "typedoc",
    "lint": "oxlint -c ../../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives --ignore-pattern 'examples/**' .",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "pathe": "2.0.3",
    "semver": "7.8.5"
  },
  "optionalDependencies": {
    "@lumis-sh/lumis-native-darwin-arm64": "workspace:*",
    "@lumis-sh/lumis-native-darwin-x64": "workspace:*",
    "@lumis-sh/lumis-native-linux-arm64-gnu": "workspace:*",
    "@lumis-sh/lumis-native-linux-arm64-musl": "workspace:*",
    "@lumis-sh/lumis-native-linux-x64-gnu": "workspace:*",
    "@lumis-sh/lumis-native-linux-x64-musl": "workspace:*",
    "@lumis-sh/lumis-native-win32-arm64-msvc": "workspace:*",
    "@lumis-sh/lumis-native-win32-x64-msvc": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@lumis-sh/themes": "workspace:*",
    "@lumis-sh/wasm-json": "0.26.5",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/semver": "7.8.0",
    "html-validate": "^11.16.2",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "smol-toml": "^1.9.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-tree-sitter": "0.27.1"
  }
}
