{
  "name": "@lumis-sh/react",
  "version": "0.3.1",
  "description": "React integration for Lumis syntax highlighting",
  "author": "Leandro Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git",
    "directory": "packages/javascript/react"
  },
  "bugs": "https://github.com/leandrocp/lumis/issues",
  "homepage": "https://lumis.sh",
  "keywords": [
    "react",
    "lumis-sh",
    "syntax-highlighting",
    "tree-sitter"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "react-server": "./dist/server.js",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.json",
    "prelint": "pnpm --filter @lumis-sh/lumis run build",
    "test": "vitest run",
    "lint": "oxlint -c ../../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives --ignore-pattern 'examples/**' .",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lumis-sh/lumis": "workspace:^",
    "hast-util-from-html": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.0",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.43.0",
    "oxlint": "1.58.0",
    "oxlint-tsgolint": "0.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
