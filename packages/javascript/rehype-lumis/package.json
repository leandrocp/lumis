{
  "name": "@lumis-sh/rehype-lumis",
  "version": "0.3.1",
  "description": "rehype plugin for Lumis syntax highlighter",
  "author": "Leandro Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git",
    "directory": "packages/javascript/rehype-lumis"
  },
  "bugs": "https://github.com/leandrocp/lumis/issues",
  "homepage": "https://lumis.sh",
  "keywords": [
    "rehype",
    "syntax-highlighting",
    "tree-sitter",
    "lumis-sh"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsup",
    "prelint": "pnpm --filter @lumis-sh/lumis run build",
    "test": "vitest run",
    "lint": "oxlint -c ../../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives --ignore-pattern 'examples/**' .",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-string": "^3.0.1",
    "property-information": "^7.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@lumis-sh/lumis": "workspace:^",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/hast": "^3.0.4",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@lumis-sh/lumis": "workspace:^"
  }
}
