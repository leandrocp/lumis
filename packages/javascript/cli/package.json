{
  "name": "@lumis-sh/cli",
  "version": "0.6.2",
  "binaryVersion": "0.5.1",
  "description": "Command line syntax highlighter powered by Tree-sitter and Neovim themes",
  "author": "Leandro Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandrocp/lumis.git",
    "directory": "packages/javascript/cli"
  },
  "bugs": "https://github.com/leandrocp/lumis/issues",
  "homepage": "https://lumis.sh",
  "keywords": [
    "lumis-sh",
    "syntax-highlighting",
    "tree-sitter",
    "neovim",
    "cli"
  ],
  "bin": {
    "lumis": "./bin/lumis"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "README.md"
  ],
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "test": "node scripts/test-shim.js"
  },
  "optionalDependencies": {
    "@lumis-sh/cli-darwin-arm64": "workspace:*",
    "@lumis-sh/cli-darwin-x64": "workspace:*",
    "@lumis-sh/cli-linux-arm64-gnu": "workspace:*",
    "@lumis-sh/cli-linux-arm64-musl": "workspace:*",
    "@lumis-sh/cli-linux-x64-gnu": "workspace:*",
    "@lumis-sh/cli-linux-x64-musl": "workspace:*",
    "@lumis-sh/cli-win32-arm64-msvc": "workspace:*",
    "@lumis-sh/cli-win32-x64-msvc": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
