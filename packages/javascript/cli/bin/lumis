#!/usr/bin/env node
"use strict";

const { spawnSync } = require("node:child_process");
const { dirname, join } = require("node:path");
const { cliTargetFor, hostLibc } = require("./target.js");

const target = cliTargetFor(process.platform, process.arch, hostLibc());

if (!target) {
  const host = `${process.platform}-${process.arch}-${hostLibc()}`;
  console.error(`@lumis-sh/cli ships no binary for ${host}.`);
  console.error("Build one with: cargo install lumis-cli");
  process.exit(1);
}

const packageName = `@lumis-sh/cli-${target}`;
const binaryName = process.platform === "win32" ? "lumis.exe" : "lumis";

let binary;
try {
  binary = join(dirname(require.resolve(`${packageName}/package.json`)), binaryName);
} catch {
  console.error(`${packageName} is not installed.`);
  console.error(
    "npm installs it as an optionalDependency of @lumis-sh/cli, so --no-optional or a",
  );
  console.error("lockfile written on another platform can leave it out.");
  console.error("Reinstall @lumis-sh/cli.");
  process.exit(1);
}

const args = process.argv.slice(2);
try {
  args.unshift("--theme-pack", require.resolve("@lumis-sh/themes-copyleft/lumis-themes.json"));
} catch (error) {
  if (error.code !== "MODULE_NOT_FOUND") throw error;
}

const result = spawnSync(binary, args, { stdio: "inherit" });

if (result.error) {
  console.error(result.error.message);
  process.exit(1);
}

if (result.signal) {
  process.kill(process.pid, result.signal);
}

process.exit(result.status ?? 0);
