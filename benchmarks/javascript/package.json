{
  "name": "@lumis-sh/benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "benchmark": "node --expose-gc src/scenarios.mjs",
    "showcase": "node src/showcase.mjs",
    "comparison-timings": "node --expose-gc src/comparison-timings.mjs",
    "fmt": "cd ../.. && oxfmt benchmarks/javascript/src/ benchmarks/scripts/",
    "fmt:check": "cd ../.. && oxfmt --check benchmarks/javascript/src/ benchmarks/scripts/",
    "lint": "cd ../.. && oxlint --deny-warnings --report-unused-disable-directives benchmarks/"
  },
  "dependencies": {
    "@catppuccin/highlightjs": "1.0.1",
    "@lumis-sh/lumis": "workspace:*",
    "@lumis-sh/themes": "workspace:*",
    "@lumis-sh/wasm-bash": "0.26.3",
    "@lumis-sh/wasm-c": "0.26.1",
    "@lumis-sh/wasm-comment": "0.26.1",
    "@lumis-sh/wasm-css": "0.26.2",
    "@lumis-sh/wasm-diff": "0.26.1",
    "@lumis-sh/wasm-elixir": "0.26.2",
    "@lumis-sh/wasm-go": "0.26.1",
    "@lumis-sh/wasm-heex": "0.26.1",
    "@lumis-sh/wasm-html": "0.26.2",
    "@lumis-sh/wasm-java": "0.26.1",
    "@lumis-sh/wasm-javascript": "0.26.2",
    "@lumis-sh/wasm-json": "0.26.2",
    "@lumis-sh/wasm-markdown": "0.26.1",
    "@lumis-sh/wasm-markdown_inline": "0.26.1",
    "@lumis-sh/wasm-python": "0.26.2",
    "@lumis-sh/wasm-ruby": "0.26.2",
    "@lumis-sh/wasm-rust": "0.26.3",
    "@lumis-sh/wasm-tsx": "0.26.1",
    "@speed-highlight/core": "latest",
    "@tanstack/highlight": "latest",
    "@wooorm/starry-night": "latest",
    "hast-util-to-html": "9.0.5",
    "highlight.js": "latest",
    "mitata": "1.0.34",
    "prismjs": "latest",
    "shiki": "latest",
    "sugar-high": "latest"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "1.58.0"
  },
  "engines": {
    "node": ">=24"
  }
}
