{
  "name": "lumis-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-agent-discovery.mjs && node scripts/check-markdown-negotiation.mjs && node scripts/check-installers.mjs && vite build",
    "check:discovery": "node scripts/check-agent-discovery.mjs",
    "check:installers": "node scripts/check-installers.mjs",
    "check:markdown": "node scripts/check-markdown-negotiation.mjs",
    "fmt": "oxfmt -c .oxfmtrc.jsonc .",
    "preview": "vite preview",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@lumis-sh/lumis": "^0.9.0",
    "@lumis-sh/themes": "^0.4.0",
    "@lumis-sh/wasm-bundle-full": "^0.1.3",
    "@lumis-sh/wasm-css": "^0.26.4",
    "@lumis-sh/wasm-elixir": "^0.26.5",
    "@lumis-sh/wasm-embedded-template": "^0.26.4",
    "@lumis-sh/wasm-heex": "^0.26.3",
    "@lumis-sh/wasm-html": "^0.26.4",
    "@lumis-sh/wasm-javascript": "^0.26.4",
    "@lumis-sh/wasm-json": "^0.26.5",
    "@lumis-sh/wasm-markdown": "^0.26.3",
    "@lumis-sh/wasm-ruby": "^0.26.4",
    "@lumis-sh/wasm-rust": "^0.26.5",
    "@lumis-sh/wasm-typescript": "^0.26.3",
    "@vercel/analytics": "^2.0.1",
    "webgl-fluid-enhanced": "^0.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "oxfmt": "^0.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.15.1"
}
