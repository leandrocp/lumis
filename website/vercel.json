{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes pnpm@11.15.1 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.15.1 build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        {
          "key": "Link",
          "value": "<https://docs.lumis.sh/llms.txt>; rel=\"describedby\"; type=\"text/plain\""
        }
      ]
    },
    {
      "source": "/comparison",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/comparison/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/showcase",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/showcase/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Link": "<https://docs.lumis.sh/llms.txt>; rel=\"describedby\"; type=\"text/plain\"",
        "Vary": "Accept",
        "x-markdown-tokens": "898"
      },
      "dest": "/index.md"
    },
    {
      "src": "^/comparison/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept",
        "x-markdown-tokens": "389"
      },
      "dest": "/comparison/index.md"
    },
    {
      "src": "^/showcase/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept",
        "x-markdown-tokens": "559"
      },
      "dest": "/showcase/index.md"
    }
  ],
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://docs.lumis.sh/",
      "statusCode": 301
    },
    {
      "source": "/docs/",
      "destination": "https://docs.lumis.sh/",
      "statusCode": 301
    }
  ]
}
